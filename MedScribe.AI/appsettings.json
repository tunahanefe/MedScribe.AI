{
  // Bağlantı cümlesi burada tutulmaz: appsettings.Local.json (git'e girmez) içindedir.
  // İlk kurulumda appsettings.Local.example.json dosyasını appsettings.Local.json olarak kopyalayıp doldurun.
  "ConnectionStrings": {
    "MiaMed": ""
  },
  "MedScribe": {
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "Model": "qwen2.5:14b",
      "TimeoutSaniye": 300,
      "Temperature": 0.1,
      "NumCtx": 16384
    },
    "TaniAnalizi": {
      "GecmisVizitAdedi": 3,
      "AdayTaniAdedi": 15,
      "IlacGunSayisi": 180,
      "LabGunSayisi": 90,
      "VizitMetniMaksimumKarakter": 600,
      // ICD-10 Z00–Z13: "genel muayene", "kontrol", "tarama" gibi hastalık bildirmeyen temas kodları.
      // Rutin vizitlerde (Medula/fatura için) sık girildiklerinden, sıklığa göre sıralanan aday tanı
      // listesinin başına geçip gerçek hastalıkları (N18, I10 ...) aşağı itiyorlardı.
      // Örn. Hasta 28018'de Z00.8 68 kez ile en sık 2. tanıydı. Klinik değeri olan Z kodları
      // (Z99.2 diyaliz, Z94.0 böbrek nakli, Z79 uzun süreli ilaç) bu aralıkta değildir, analize girer.
      "HaricIcdAraliklari": [ "Z00-Z13" ],
      // false (varsayılan): yukarıdaki aralıklar aday listesinden çıkarılır; debug modunda neyin elendiği gösterilir.
      // true: filtre devre dışı — elemenin öneri kalitesine etkisini karşılaştırmak veya bu kodlara
      // gerçekten ihtiyaç duyan bir birim için. Listeyi silmeden filtreyi kapatmayı sağlar.
      "HaricKodlariDahilEt": false,
      "EsAnlamlilar": {
        "idrar yolu": "üriner sistem",
        "yüksek tansiyon": "hipertansiyon",
        "tansiyon": "hipertansiyon",
        "şeker hastalığı": "diyabetes mellitüs"
      }
    },
    // "Klavye": her satır bir ifade. "Mikrofon": Whisper ile gerçek ses (klavye de çalışmaya devam eder).
    "Ses": {
      "Mod": "Mikrofon",
      "ModelYolu": "models/ggml-large-v3-turbo-q8_0.bin",
      "Dil": "tr",
      "MikrofonNo": 0,
      "EnerjiEsigi": 0.012,
      "GurultuCarpani": 3.0,
      "SessizlikMs": 900,
      "OnKayitMs": 300,
      "MinKonusmaMs": 400,
      "MaxIfadeSaniye": 25,
      // Whisper'a alan terimlerini ve komutları öğretir; tanınmayan terimleri buraya ekleyin.
      "Prompt": "Poliklinik muayene notu. Şikayeti, hikayesi, özgeçmiş, soygeçmiş, fizik muayene, bulgular, tedavi planı. Tansiyon 150'ye 95, nabız 88, ateş 36,6. Kreatinin, hemoglobin, ferritin, pretibial ödem, kostovertebral açı hassasiyeti. Muayeneyi tamamla. Son cümleyi sil. Transkripti göster. Hemogram tetkiki ekle."
    },
    "Debug": {
      "Aktif": true,
      "DosyayaYaz": false,
      "LogKlasoru": "logs"
    },
    "Muayene": {
      "SonBasvuruAdedi": 10,
      "VarsayilanTaniAdedi": 10
    },
    "KlinikHizmet": {
      "HizmetDurumTurId": 2,
      "Miktar": 1,
      "IsteyenDoktorId": null,
      "KaydedenKullaniciId": null,
      "EsAnlamlilar": {
        "tam kan sayımı": "hemogram",
        "tam kan": "hemogram",
        "kan sayımı": "hemogram"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
