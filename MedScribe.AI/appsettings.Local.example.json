{
  // Bu dosyayı appsettings.Local.json adıyla kopyalayıp gerçek değerleri girin. appsettings.Local.json git'e girmez.
  "ConnectionStrings": {
    "MiaMed": "Data Source=<sunucu>;Initial Catalog=<veritabani>;User ID=<kullanici>;Password=<sifre>;TrustServerCertificate=True;Encrypt=True;Application Name=MedScribeAI"
  },
  // Makineye özel ayarlar (isteğe bağlı; appsettings.json değerlerini ezer).
  "MedScribe": {
    "Ses": {
      // Vulkan cihaz sırası: `vulkaninfo --summary` çıktısında NVIDIA kartın GPU<n> numarası (bkz. KURULUM.md §6).
      "GpuCihazNo": 1
    },
    "Debug": {
      // true: LLM bağlamı (hasta verisi) konsola yazılır. Demo/gerçek kullanımda false yapın.
      "Aktif": true
    }
  }
}
